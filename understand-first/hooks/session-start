#!/usr/bin/env bash
set -euo pipefail

script_dir() {
  case "$0" in
    */*) (cd "${0%/*}" && pwd) ;;
    *) pwd ;;
  esac
}

escape_for_json() {
  local text="$1"
  text="${text//\\/\\\\}"
  text="${text//\"/\\\"}"
  text="${text//$'\n'/\\n}"
  text="${text//$'\r'/\\r}"
  text="${text//$'\t'/\\t}"
  printf '%s' "$text"
}

install_status_script() {
  { mkdir -p "$data_dir" && printf '%s\n' "$(<"${hooks_dir%/*}/statusline/status.sh")" > "${data_dir}/status.sh"; } 2>/dev/null || true
}

viewer_is_on() {
  local line
  [ -r "$ledger_path" ] || return 1
  while IFS= read -r line; do
    case "$line" in
      "viewer: on") return 0 ;;
      "#"*) return 1 ;;
    esac
  done < "$ledger_path"
  return 1
}

start_viewer() {
  viewer_is_on || return 0
  PATH="$PATH:/usr/bin:/usr/local/bin:/opt/homebrew/bin"
  command -v python3 >/dev/null 2>&1 || return 0
  viewer_url="$(python3 "${hooks_dir%/*}/scripts/viewer.py" ensure 2>/dev/null)" || viewer_url=""
}

hooks_dir="$(script_dir)"
data_dir="${UNDERSTAND_FIRST_DATA:-$HOME/.claude/understand-first}"
ledger_path="${data_dir}/ledger.md"
events_path="${data_dir}/events.jsonl"
viewer_url=""

install_status_script
start_viewer

rules="$(<"${hooks_dir}/core-rules.md")"

if [ -r "$ledger_path" ]; then
  ledger="$(<"$ledger_path")"
else
  ledger="(no ledger yet: ask the learner for their primary language, then create it with stage 1 before the first gate)"
fi

context="${rules}"$'\n\n'"Ledger path: ${ledger_path}"$'\n'"Event log path: ${events_path}"$'\n'"Source map: ${hooks_dir%/*}/sources.md"$'\n'"Added sources: ${data_dir}/sources-added.md"$'\n'"Work log: ${data_dir}/work.md"${viewer_url:+$'\n'"Live viewer: ${viewer_url}"}$'\n\n'"Ledger contents:"$'\n'"${ledger}"

printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$(escape_for_json "$context")"
