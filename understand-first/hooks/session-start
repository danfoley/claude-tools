#!/usr/bin/env bash
set -euo pipefail

script_dir() {
  case "$0" in
    */*) (cd "${0%/*}" && pwd) ;;
    *) pwd ;;
  esac
}

escape_for_json() {
  local text="$1"
  text="${text//\\/\\\\}"
  text="${text//\"/\\\"}"
  text="${text//$'\033'/\\u001b}"
  text="${text//$'\n'/\\n}"
  text="${text//$'\r'/\\r}"
  text="${text//$'\t'/\\t}"
  printf '%s' "$text"
}

style() {
  local codes="$1" text="$2"
  [ -z "${NO_COLOR:-}" ] || { printf '%s' "$text"; return 0; }
  printf '\033[%sm%s\033[0m' "$codes" "$text"
}

with_coloured_bullets() {
  local line coloured=""
  while IFS= read -r line; do
    case "$line" in
      "- "*) coloured+="$(style 36 "-") ${line#- }"$'\n' ;;
      *) coloured+="${line}"$'\n' ;;
    esac
  done <<< "$1"
  printf '%s' "${coloured%$'\n'}"
}

install_status_script() {
  { mkdir -p "$data_dir" && printf '%s\n' "$(<"${hooks_dir%/*}/statusline/status.sh")" > "${data_dir}/status.sh"; } 2>/dev/null || true
}

viewer_is_on() {
  local line
  [ -r "$ledger_path" ] || return 1
  while IFS= read -r line; do
    case "$line" in
      "viewer: on") return 0 ;;
      "#"*) return 1 ;;
    esac
  done < "$ledger_path"
  return 1
}

start_viewer() {
  viewer_is_on || return 0
  PATH="$PATH:/usr/bin:/usr/local/bin:/opt/homebrew/bin"
  command -v python3 >/dev/null 2>&1 || return 0
  viewer_url="$(python3 "${hooks_dir%/*}/scripts/viewer.py" ensure 2>/dev/null)" || viewer_url=""
}

pull_from_storage() {
  local output status=0
  PATH="$PATH:/usr/bin:/usr/local/bin:/opt/homebrew/bin"
  command -v python3 >/dev/null 2>&1 || return 0
  output="$(python3 "${hooks_dir%/*}/scripts/sync.py" pull 2>&1)" || status=$?
  [ "$status" -eq 0 ] && return 0
  storage_notice="STORAGE PROBLEM, tell the learner before anything else: ${output}"$'\n'"Their data is safe in their storage backend, but this session started from the local copy, which may be missing or out of date. Ask whether to carry on with local storage only. Only if they say yes, run: python3 ${hooks_dir%/*}/scripts/sync.py disable. Never run it without their answer."
}

plugin_version() {
  sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "${hooks_dir%/*}/.claude-plugin/plugin.json" | head -n 1
}

release_notes_for() {
  local version="$1" line in_section=0 notes=""
  [ -r "$whats_new_path" ] || return 0
  while IFS= read -r line; do
    case "$line" in
      "## ${version}") in_section=1 ;;
      "## "*) [ "$in_section" -eq 1 ] && break ;;
      *) [ "$in_section" -eq 1 ] && notes+="${line}"$'\n' ;;
    esac
  done < "$whats_new_path"
  printf '%s' "$notes"
}

announce_update() {
  local version seen="" notes
  version="$(plugin_version)"
  [ -n "$version" ] || return 0
  [ -r "$version_stamp_path" ] && seen="$(<"$version_stamp_path")"
  [ "$seen" = "$version" ] && return 0
  { mkdir -p "$data_dir" && printf '%s\n' "$version" > "$version_stamp_path"; } 2>/dev/null || true
  [ -n "$seen" ] || [ -r "$ledger_path" ] || return 0
  if [ -n "$seen" ]; then
    update_notice="$(style '1;32' "understand-first updated from ${seen} to ${version}")"
  else
    update_notice="$(style '1;32' "understand-first ${version} is installed")"
  fi
  notes="$(release_notes_for "$version")"
  [ -z "$notes" ] || update_notice+=$'\n'"$(style '1;33' "What's new:")"$'\n'"$(with_coloured_bullets "${notes%$'\n'}")"
}

ledger_stage() {
  local line
  [ -r "$ledger_path" ] || return 0
  while IFS= read -r line; do
    case "$line" in
      "stage: "*) printf '%s' "${line#stage: }"; return 0 ;;
      "#"*) return 0 ;;
    esac
  done < "$ledger_path"
}

announce_startup() {
  local stage running
  stage="$(ledger_stage)"
  running="$(style '1;35' "Running understand first")"
  if [ -z "$stage" ]; then
    status_line="${running} (no ledger yet, the first session creates it)"
  elif [ -n "$viewer_url" ]; then
    status_line="${running} at level $(style '1;36' "$stage"), view is here $(style '4;36' "$viewer_url")"
  else
    status_line="${running} at level $(style '1;36' "$stage"). The viewer is off: turn it on with $(style 36 "/understand-first:menu viewer on")"
  fi
}

is_compaction() {
  case "$hook_input" in
    *'"source"'*'"compact"'*) return 0 ;;
  esac
  return 1
}

hooks_dir="$(script_dir)"
data_dir="${UNDERSTAND_FIRST_DATA:-$HOME/.claude/understand-first}"
ledger_path="${data_dir}/ledger.md"
events_path="${data_dir}/events.jsonl"
version_stamp_path="${data_dir}/last-seen-version"
whats_new_path="${hooks_dir%/*}/whats-new.md"
viewer_url=""
storage_notice=""
update_notice=""
status_line=""
hook_input=""
IFS= read -r -t 2 -d '' hook_input || true

pull_from_storage
install_status_script
start_viewer
announce_update
announce_startup

rules="$(<"${hooks_dir}/core-rules.md")"

if [ -r "$ledger_path" ]; then
  ledger="$(<"$ledger_path")"
else
  ledger="(no ledger yet: ask the learner for their primary language, then create it with stage 1 before the first gate)"
fi

context="${rules}"${storage_notice:+$'\n\n'"${storage_notice}"}$'\n\n'"Ledger path: ${ledger_path}"$'\n'"Event log path: ${events_path}"$'\n'"Source map: ${hooks_dir%/*}/sources.md"$'\n'"Added sources: ${data_dir}/sources-added.md"$'\n'"Work log: ${data_dir}/work.md"${viewer_url:+$'\n'"Live viewer: ${viewer_url}"}$'\n\n'"Ledger contents:"$'\n'"${ledger}"

system_message=""
is_compaction || system_message="$status_line"
[ -z "$update_notice" ] || system_message="${system_message:+${system_message}$'\n\n'}${update_notice}"
system_message_field=""
[ -z "$system_message" ] || system_message_field="\"systemMessage\":\"$(escape_for_json "$system_message")\","

printf '{%s"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$system_message_field" "$(escape_for_json "$context")"
